        <!-- ============ <<include>> (base -> included) ============ -->
        <mxCell id="i1" value="«include»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;" edge="1" parent="1" source="u03" target="u05"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i2" value="«include»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;" edge="1" parent="1" source="u03" target="u06"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i3" value="«include»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;" edge="1" parent="1" source="u11" target="u12"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ <<extend>> (extension -> base, with condition) ============ -->
        <mxCell id="x1" value="«extend»&lt;br&gt;&lt;i&gt;[không có thông tin trong kho]&lt;/i&gt;" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;" edge="1" parent="1" source="u13" target="u11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x2" value="«extend» &lt;i&gt;[hỏi tiếp trong cùng hội thoại]&lt;/i&gt;" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="u15" target="u11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x3" value="«extend»&lt;br&gt;&lt;i&gt;[người dùng bấm trích dẫn]&lt;/i&gt;" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;" edge="1" parent="1" source="u14" target="u12"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ Legend ============ -->
        <mxCell id="lg1" value="&lt;b&gt;Chú giải ký hiệu&lt;/b&gt;&lt;br&gt;• Nét liền, không mũi tên: association (actor ↔ use case)&lt;br&gt;• Nét đứt «include»: hành vi bắt buộc (base → included)&lt;br&gt;• Nét đứt «extend» [điều kiện]: hành vi tùy chọn (extension → base)&lt;br&gt;• Mũi tên tam giác rỗng: generalization (con → cha)&lt;br&gt;• Viền đậm = P0 · viền mảnh = P1&lt;br&gt;• Tên actor in nghiêng = actor trừu tượng; actor xám = hệ thống bên ngoài (Secondary)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#F5F5F5;strokeColor=#999999;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="230" y="1400" width="440" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="lg2" value="&lt;b&gt;Truy vết&lt;/b&gt; — nguồn PRD-CWD-001 v0.1 (US-001 → US-019)&lt;br&gt;• UC02 (US-002) đã bỏ khỏi hệ thống: đây là rà soát hợp đồng, không phải chức năng → thể hiện bằng ghi chú ràng buộc.&lt;br&gt;• US-014 (thời gian phản hồi) và BR-014 (độ chính xác) là thuộc tính chất lượng của UC11/UC12.&lt;br&gt;• Chưa vẽ use case P2: BR-017, BR-018, BR-019.&lt;br&gt;• Cách đăng nhập (SSO hay tài khoản riêng) chờ OQ-020." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#F5F5F5;strokeColor=#999999;spacing=8;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="1400" width="440" height="130" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
